{
  "compilerOptions": {
    "baseUrl": "src",
    "target": "es2022",
    "module": "commonjs",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom", "jest"]
  },
  "include": ["src"]
}